<?xml version="1.0" encoding="utf-8"?>
<!-- RelativeLayout ubica cada vista respecto al padre o a otra vista por su id. -->
<!-- background pone una imagen de fondo que cubre toda la pantalla. -->
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/fondo_principal"
    tools:context=".MainActivity">

    <!-- centerHorizontal centra la vista en horizontal dentro del padre. -->
    <!-- contentDescription es el texto que leen los lectores de pantalla para describir la imagen. -->
    <ImageView
        android:id="@+id/ivLogo"
        android:layout_width="144dp"
        android:layout_height="60dp"
        android:layout_marginTop="50dp"
        android:layout_centerHorizontal="true"
        android:contentDescription="@string/sello_personal"
        android:src="@drawable/sello_shairo"
        />

    <!-- layout_below coloca el título debajo de la vista con id ivLogo. -->
    <TextView
        android:id="@+id/tvTitulo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/login"
        android:textSize="22sp"
        android:textColor="@color/white"
        android:textStyle="bold"
        android:layout_below="@+id/ivLogo"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="60dp"
        />

    <!-- ScrollView permite desplazar el contenido si no cabe en la pantalla, por ejemplo con el teclado abierto. -->
    <!-- Solo admite un hijo directo, por eso el formulario va dentro de un RelativeLayout. -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginStart="30dp"
        android:layout_marginEnd="30dp"
        android:layout_below="@id/tvTitulo"
        android:layout_marginTop="10dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- TextInputLayout es un contenedor de Material que envuelve un campo de texto. -->
            <!-- Hace que el hint suba como etiqueta flotante cuando el usuario empieza a escribir. -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/Usuario"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_centerHorizontal="true"
                android:layout_marginTop="50dp">

                <!-- EditText es el campo donde se escribe; hint es el texto guía que se ve cuando está vacío. -->
                <!-- inputType="textEmailAddress" abre el teclado con @ y punto a la mano. -->
                <EditText
                    android:id="@+id/etUsuario"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/white"
                    android:hint="@string/usuario"
                    android:inputType="textEmailAddress"/>

            </com.google.android.material.textfield.TextInputLayout>

            <!-- passwordToggleEnabled agrega el icono de ojo para mostrar u ocultar la clave. -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/Clave"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/Usuario"
                android:layout_marginTop="15dp"
                app:passwordToggleEnabled="true">

                <EditText
                    android:id="@+id/etClave"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/clave"
                    android:inputType="textPassword"
                    />

            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:id="@+id/tvOlvidaste"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@id/Clave"
                android:text="@string/olvidaste_contraseña"
                android:textColor="@color/white"
                android:textStyle="bold"
                android:layout_alignParentEnd="true"
                android:layout_marginTop="15dp"
                />

            <Button
                android:id="@+id/btnIngresar"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_below="@+id/tvOlvidaste"
                android:layout_marginTop="15dp"
                android:text="@string/ingresar"
                android:backgroundTint="@color/verde_esmeralda"
                />

            <Button
                android:id="@+id/btnWeb"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_below="@+id/btnIngresar"
                android:layout_marginTop="10dp"
                android:text="@string/web"
                android:backgroundTint="@color/azul_cielo"
                />

            <TextView
                android:id="@+id/tvRegistrate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/no_cuenta"
                android:layout_below="@+id/btnWeb"
                android:layout_marginTop="30dp"
                android:textColor="@color/white"
                android:textStyle="bold"
                android:textSize="25sp"
                android:layout_centerHorizontal="true"
                />

        </RelativeLayout>

    </ScrollView>

</RelativeLayout>