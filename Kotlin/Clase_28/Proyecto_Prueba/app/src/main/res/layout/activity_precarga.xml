<?xml version="1.0" encoding="utf-8"?>
<!-- LinearLayout acomoda sus hijos en fila; orientation="vertical" los pone uno debajo del otro. -->
<!-- gravity="center" centra los hijos dentro del layout y background usa una imagen de res/drawable. -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/fondo"
    android:gravity="center"
    tools:context=".Precarga">

    <!-- dp es una unidad independiente de la densidad de pantalla; mide igual en cualquier celular. -->
    <!-- @drawable/nombre apunta a un archivo de res/drawable sin su extensión. -->
    <ImageView
        android:layout_width="170dp"
        android:layout_height="174dp"
        android:src="@drawable/cohete_logo"
        tools:ignore="ContentDescription" />


</LinearLayout>
