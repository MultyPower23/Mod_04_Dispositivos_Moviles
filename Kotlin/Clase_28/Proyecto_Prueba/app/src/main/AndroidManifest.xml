<?xml version="1.0" encoding="utf-8"?>
<!-- El manifiesto le describe la app a Android: nombre, icono, tema y pantallas que existen. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Configuración general de la app; los valores con @ vienen de la carpeta res/. -->
    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Proyecto_Prueba">
        <!-- Toda Activity debe declararse aquí; exported="false" impide que otras apps la abran. -->
        <activity
            android:name=".Precarga"
            android:exported="false" />
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <!-- MAIN y LAUNCHER marcan esta Activity como la que se abre desde el icono de la app. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
