{
  "files.autoSave": "afterDelay",
  "workbench.startupEditor": "none",
  "workbench.colorTheme": "One Dark Pro Night Flat",
  "workbench.iconTheme": "material-icon-theme",

  "explorer.confirmDragAndDrop": false,
  "explorer.confirmDelete": false,

  // ==================== CONFIGURACIONES GENERALES ====================
  "editor.formatOnSave": true,
  "editor.formatOnPaste": true,
  "editor.detectIndentation": true,
  "editor.tabSize": 2,
  "editor.insertSpaces": true,
  "editor.inlineSuggest.enabled": true,
  "files.trimTrailingWhitespace": true,

  // ==================== ANDROID (Java, Kotlin, XML, Gradle) ====================
  // El formato lo da Android Studio (4 espacios); VS Code no reformatea estos archivos.
  "[java]": {
    "editor.formatOnSave": false,
    "editor.formatOnPaste": false,
    "editor.tabSize": 4
  },
  "[kotlin]": {
    "editor.formatOnSave": false,
    "editor.formatOnPaste": false,
    "editor.tabSize": 4
  },
  "[xml]": {
    "editor.formatOnSave": false,
    "editor.formatOnPaste": false,
    "editor.tabSize": 4
  },
  "[groovy]": {
    "editor.formatOnSave": false,
    "editor.tabSize": 4
  },

  // Carpetas que generan Android Studio y Gradle, fuera del explorador y la búsqueda.
  "files.exclude": {
    "**/.gradle": true,
    "**/.idea": true,
    "**/build": true,
    "**/.cxx": true,
    "**/local.properties": true
  },
  "search.exclude": {
    "**/*.apk": true,
    "**/gradlew": true,
    "**/gradlew.bat": true
  },

  // ==================== MARKDOWN ====================
  "[markdown]": {
    "editor.formatOnSave": true
  },
  "workbench.editorAssociations": {
    "**/Clase_*.md": "vscode.markdown.preview.editor"
  },

  // ==================== LINTERS ====================
  "editor.codeActionsOnSave": {
    "source.fixAll.markdownlint": "explicit"
  },

  "github.copilot.editor.enableAutoCompletions": true,
  "github.copilot.enable": {
    "*": true,
    "plaintext": false,
    "markdown": true,
    "scminput": false
  },

  // ==================== ICONOS ====================
  "material-icon-theme.files.associations": {
    "Clase_27.md": "changelog",
    "Clase_28.md": "changelog",
    "Clase_29.md": "changelog",
    "Clase_30.md": "changelog",
    "Clase_31.md": "changelog"
  },

  "material-icon-theme.folders.associations": {
    "Juann_Ciro": "project",
    "Prueba1": "test",
    "Proyecto_Prueba": "temp",
    "Dispositivos": "mobile"
  }
}
